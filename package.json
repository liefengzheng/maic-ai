{
  "name": "maic-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @maic/api\" \"npm run dev -w @maic/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "python -m alembic -c apps/api/alembic.ini upgrade head"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}